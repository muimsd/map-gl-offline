{
  "name": "map-gl-offline",
  "version": "0.8.7",
  "description": "A TypeScript-compatible npm package for MapLibre GL JS that enables comprehensive offline storage and usage of vector/raster tiles, sprites, styles, fonts (glyphs), and entire map regions with advanced analytics, import/export capabilities, and intelligent cleanup.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "bin": {
    "map-gl-offline": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./vite-plugin": "./dist/vite-plugin.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/muimsd/map-gl-offline.git"
  },
  "homepage": "https://map-gl-offline.netlify.app/",
  "demo": "https://map-gl-offline-demo.netlify.app/",
  "bugs": {
    "url": "https://github.com/muimsd/map-gl-offline/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:clean && npm run build:sw-src && npm run build:lib && npm run build:types && npm run build:css && npm run build:sw",
    "build:clean": "rimraf dist",
    "build:lib": "rollup -c",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist && tsc-alias -p tsconfig.json --outDir dist",
    "build:css": "tailwindcss -i src/styles/style.css -o dist/style.css --minify",
    "build:sw-src": "node scripts/build-sw.mjs",
    "build:sw": "cp public/idb-offline-sw.js dist/idb-offline-sw.js && cp bin/vite-plugin.js dist/vite-plugin.js",
    "build:watch": "rollup -c -w",
    "build:dev": "npm run build:clean && npm run build:lib",
    "build:demo": "vite build --outDir demo",
    "preview": "vite preview --outDir demo",
    "preview:demo": "vite preview --outDir demo",
    "start:examples": "cd examples/maplibre && npm i && npm run dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false --testPathIgnorePatterns='tests/e2e'",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:warn": "eslint src --max-warnings 200",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test:ci",
    "validate:strict": "npm run typecheck && npm run lint && npm run test:ci",
    "clean": "npm run build:clean && rimraf node_modules/.cache",
    "prepublishOnly": "npm run validate && npm run build",
    "release": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish",
    "release:dry": "npm publish --dry-run",
    "docs": "cd docs && npm start",
    "docs:build": "cd docs && npm run build",
    "docs:serve": "cd docs && npm run serve",
    "docs:deploy": "cd docs && npm run deploy",
    "prepare": "husky"
  },
  "keywords": [
    "mapbox-gl",
    "maplibre-gl",
    "offline",
    "maps",
    "tiles",
    "caching",
    "indexeddb",
    "pwa",
    "vector-tiles",
    "raster-tiles",
    "sprites",
    "fonts",
    "glyphs",
    "mbtiles",
    "import",
    "export",
    "typescript",
    "progressive-web-app",
    "offline-maps",
    "map-tiles",
    "mobile",
    "analytics"
  ],
  "author": "Muhammad Imran Siddique",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@mapbox/tilebelt": "^2.0.3",
    "@turf/area": "^7.3.4",
    "@turf/bbox-polygon": "^7.3.4",
    "@turf/difference": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "i18next": "^25.8.11",
    "idb": "^8.0.3",
    "sql.js": "^1.14.1"
  },
  "peerDependencies": {
    "mapbox-gl": ">=2.0.0",
    "maplibre-gl": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "mapbox-gl": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tailwindcss/cli": "^4.2.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/jest": "^30.0.0",
    "@types/mapbox__tilebelt": "^1.0.4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^25.3.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.24",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "map-gl-style-switcher": "^0.9.2",
    "mapbox-gl": "^3.18.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.1",
    "puppeteer": "^24.37.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.0",
    "rollup-plugin-dts": "^6.3.0",
    "tailwindcss": "^4.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
