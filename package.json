{
  "name": "map-gl-offline",
  "version": "0.1.0",
  "description": "An npm package for Mapbox GL JS and MapLibre GL JS that allows offline storage and usage of vector and raster tiles, sprites, styles, and entire map regions.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/muimsd/map-gl-offline.git"
  },
  "homepage": "https://github.com/muimsd/map-gl-offline#readme",
  "bugs": {
    "url": "https://github.com/muimsd/map-gl-offline/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:clean && npm run build:lib && npm run build:types",
    "build:clean": "rimraf dist",
    "build:lib": "rollup -c",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:watch": "rollup -c -w",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx --ignore-pattern 'src/main.ts'",
    "lint:fix": "eslint src --ext .ts,.tsx --ignore-pattern 'src/main.ts' --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run validate && npm run build",
    "release": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "keywords": [
    "mapbox-gl",
    "maplibre-gl",
    "offline"
  ],
  "author": "Muhammad Imran Siddique",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@mapbox/tilebelt": "^2.0.2",
    "idb": "^8.0.2",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "mapbox-gl": "^2.0.0",
    "maplibre-gl": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "@types/mapbox-gl": "^3.4.1",
    "@types/mapbox__tilebelt": "^1.0.4",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.4.1",
    "fake-indexeddb": "^6.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "30.0.0-beta.3",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.37.0",
    "rollup-plugin-dts": "^6.2.1",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.2.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
